<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TypeyTypey</AssemblyName>
    <RootNamespace>TypeyTypey</RootNamespace>
    <ApplicationIcon>typeytypey.ico</ApplicationIcon>
    <Version>1.0.4</Version>
    <AssemblyVersion>1.0.4.0</AssemblyVersion>
    <FileVersion>1.0.4.0</FileVersion>
    <!-- Without this the SDK appends "+<commit sha>" to ProductVersion, which Explorer shows. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Win32 version resource. AssemblyTitle becomes FileDescription, which is the string
         Explorer and Task Manager show; Product, Company and Copyright map directly. -->
    <AssemblyTitle>Types clipboard text as simulated keyboard input</AssemblyTitle>
    <Product>TypeyTypey</Product>
    <Company>SwedishLesbian</Company>
    <Copyright>Copyright © 2026 SwedishLesbian</Copyright>
    <Description>Types clipboard text as simulated keyboard input.</Description>
    <Authors>SwedishLesbian</Authors>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="TypeyTypey.Tests/**/*.cs" />
  </ItemGroup>
</Project>
