<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TypeyTypey</AssemblyName>
    <RootNamespace>TypeyTypey</RootNamespace>
    <ApplicationIcon>typeytypey.ico</ApplicationIcon>
    <Version>1.0.5</Version>
    <AssemblyVersion>1.0.5.0</AssemblyVersion>
    <FileVersion>1.0.5.0</FileVersion>
    <!-- Without this the SDK appends "+<commit sha>" to ProductVersion, which Explorer shows. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Win32 version resource. AssemblyTitle becomes FileDescription, which is the string
         Explorer and Task Manager show; Product, Company and Copyright map directly. -->
    <AssemblyTitle>Types clipboard text as simulated keyboard input</AssemblyTitle>
    <Product>TypeyTypey</Product>
    <Company>Larry Petersen</Company>
    <Copyright>Copyright © 2026 Larry Petersen</Copyright>
    <Description>Types clipboard text as simulated keyboard input.</Description>
    <Authors>Larry Petersen</Authors>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="TypeyTypey.Tests/**/*.cs" />
    <!-- tools/diagnostics/ScalingDiag is a standalone harness with its own entry point. Without
         this the default **/*.cs glob would pull it in and collide with Program.Main. -->
    <Compile Remove="tools/**/*.cs" />
  </ItemGroup>
  <!-- Publishing buries the executable under bin\Release\<tfm>\<rid>\publish\. Copy it to a stable
       bin\TypeyTypey.exe so it is easy to find and run. bin\ is already gitignored. The canonical
       publish directory is left untouched, so the CI artifact and release jobs are unaffected. -->
  <Target Name="CopyPublishedExecutableToBin" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe"
          DestinationFolder="$(MSBuildProjectDirectory)\bin\"
          SkipUnchangedFiles="false" />
    <Message Importance="high" Text="Executable: $(MSBuildProjectDirectory)\bin\$(AssemblyName).exe" />
  </Target>
</Project>
