<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the part of the test suite that does not need Windows. See README.md in this folder for
       what that does and does not prove. Targets plain net8.0 on purpose: the moment this project
       targets net8.0-windows it stops building anywhere except Windows, which is the whole point. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>TypeyTypey.LinuxPolicyCheck</AssemblyName>
    <RootNamespace>TypeyTypey</RootNamespace>
    <!-- WindowsIdentity in ScheduledTaskManager is Windows-only by construction; this project only
         compiles that code, it never calls it. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Linked, never copied. A copy would drift from the real source and prove nothing. -->
  <ItemGroup>
    <Compile Include="../../Core/PendingSelection.cs" Link="PendingSelection.cs" />
    <Compile Include="../../App/AppCommand.cs" Link="AppCommand.cs" />
    <Compile Include="../../Windows/ScheduledTaskManager.cs" Link="ScheduledTaskManager.cs" />
    <Compile Include="../../TypeyTypey.Tests/SelectionAndTaskTests.cs" Link="SelectionAndTaskTests.cs" />
  </ItemGroup>

</Project>
